{
  "__inputs": [
    {
      "name": "DS_CASH_FLOW_COMMANDER",
      "label": "Cash Flow Commander Postgres",
      "description": "Postgres datasource for the apps database, connecting as grafana_ro.",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "13.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-postgresql-datasource",
      "name": "PostgreSQL",
      "version": "1.0.0"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CASH_FLOW_COMMANDER}"
      },
      "description": "Every loan's principal on its newest statement, added together.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CASH_FLOW_COMMANDER}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT SUM(balance) AS \"Owed\" FROM (SELECT DISTINCT ON (account_id) account_id, balance FROM cash_flow_commander.account_balances WHERE account_kind = 'loan' ORDER BY account_id, as_of_date DESC) latest",
          "refId": "A"
        }
      ],
      "title": "Principal owed now",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CASH_FLOW_COMMANDER}"
      },
      "description": "Principal repaid across every statement held.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CASH_FLOW_COMMANDER}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT -SUM(principal) AS \"Principal\" FROM cash_flow_commander.loan_transactions",
          "refId": "A"
        }
      ],
      "title": "Principal paid to date",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CASH_FLOW_COMMANDER}"
      },
      "description": "Interest paid across every statement held: the cost of borrowing.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Interest"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CASH_FLOW_COMMANDER}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT -SUM(interest) AS \"Interest\" FROM cash_flow_commander.loan_transactions",
          "refId": "A"
        }
      ],
      "title": "Interest paid to date",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CASH_FLOW_COMMANDER}"
      },
      "description": "Everything paid toward the loans, principal and interest.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CASH_FLOW_COMMANDER}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT -SUM(amount) AS \"Paid\" FROM cash_flow_commander.loan_transactions",
          "refId": "A"
        }
      ],
      "title": "Payments to date",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CASH_FLOW_COMMANDER}"
      },
      "description": "Every loan added together. On each date a loan holds its newest statement balance on or before it.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 3,
            "showPoints": "always",
            "spanNulls": true
          },
          "unit": "currencyUSD"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Owed on all loans"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CASH_FLOW_COMMANDER}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH days AS (SELECT DISTINCT as_of_date FROM cash_flow_commander.account_balances WHERE account_kind = 'loan'), accounts AS (SELECT DISTINCT account_id FROM cash_flow_commander.account_balances WHERE account_kind = 'loan') SELECT (days.as_of_date::timestamp AT TIME ZONE 'America/Chicago') AS \"time\", SUM(held.balance) AS \"Owed on all loans\" FROM days CROSS JOIN accounts CROSS JOIN LATERAL (SELECT b.balance FROM cash_flow_commander.account_balances b WHERE b.account_kind = 'loan' AND b.account_id = accounts.account_id AND b.as_of_date <= days.as_of_date ORDER BY b.as_of_date DESC LIMIT 1) held GROUP BY days.as_of_date ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Principal owed - all loans",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CASH_FLOW_COMMANDER}"
      },
      "description": "One line per loan, one point per monthly statement.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 3,
            "showPoints": "always",
            "spanNulls": true
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CASH_FLOW_COMMANDER}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT (as_of_date::timestamp AT TIME ZONE 'America/Chicago') AS \"time\", provider || ' ' || account_id AS metric, balance AS \"value\" FROM cash_flow_commander.account_balances WHERE account_kind = 'loan' ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Principal owed by loan",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CASH_FLOW_COMMANDER}"
      },
      "description": "How each payment split. Early payments that were interest only show no principal.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "currencyUSD"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Principal"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Interest"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CASH_FLOW_COMMANDER}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (trans_date::timestamp AT TIME ZONE 'America/Chicago') AS \"time\", -SUM(principal) AS \"Principal\", -SUM(interest) AS \"Interest\" FROM cash_flow_commander.loan_transactions GROUP BY trans_date ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Each payment: principal vs interest",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_CASH_FLOW_COMMANDER}"
      },
      "description": "Every transaction on every loan statement held, newest first.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "id": 8,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_CASH_FLOW_COMMANDER}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT trans_date AS \"Date\", provider || ' ' || account_id AS \"Loan\", description AS \"Description\", amount AS \"Amount\", principal AS \"Principal\", interest AS \"Interest\", principal_balance AS \"Owed after\" FROM cash_flow_commander.loan_transactions ORDER BY trans_date DESC, account_id",
          "refId": "A"
        }
      ],
      "title": "Loan transactions",
      "type": "table"
    }
  ],
  "refresh": "",
  "schemaVersion": 39,
  "tags": [
    "cash-flow-commander",
    "loans",
    "balances"
  ],
  "time": {
    "from": "now-5y",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Cash Flow Commander \u2014 Loans",
  "uid": "cfc-loans",
  "version": 1
}
