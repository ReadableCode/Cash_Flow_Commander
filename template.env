# Template for the private .env (symlinked from personal credentials — never commit real values)

# --- Raw billing ingestion (step 1) ---
# Default is local SQLite. Postgres later, e.g.:
#   postgresql+psycopg://cash_flow_commander_user:PASSWORD@HOST:5432/apps
CFC_DATABASE_URL=sqlite:///data/cash_flow_commander.db
# Empty for sqlite; cash_flow_commander for postgres
CFC_DB_SCHEMA=
# Optional colon-separated default dirs for the ingest CLI. Entries may use
# $ONEDRIVE_DOCS to point inside the OneDrive personal Documents tree without
# hardcoding one Mac's path. Write it UNBRACED: python-dotenv interpolates
# ${VAR} and would collapse an unset one to '', leaving a path rooted at '/'.
CFC_RAW_INGEST_DIRS=

# --- Grafana (dashboard export/import) ---
# Base URL of the Grafana instance, e.g. http://HOST:3000 — no trailing slash.
GRAFANA_URL=
# Admin credentials, used only to export/import dashboard JSON via the HTTP API.
# Prefer a service account token over the admin password where possible.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
# Least-privilege login the Grafana datasource itself uses (SELECT-only).
GRAFANA_RO_PASSWORD=
